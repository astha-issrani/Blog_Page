# ════════════════════════════════════════
#   WriteFlow — MERN Stack .gitignore
#   Place this in: my-article/
# ════════════════════════════════════════

# ── Environment variables (NEVER commit)
.env
.env.local
.env.development
.env.production
.env.test
.env.staging
*.env

# ── Dependencies
node_modules/
.pnp
.pnp.js
package-lock.json
yarn.lock

# ── Frontend build output (Vite / React)
frontend/dist/
frontend/build/
frontend/.vite/

# ── Backend build output
backend/dist/
backend/build/

# ── Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sw?
.history/

# ── Testing & Coverage
coverage/
.nyc_output/
*.lcov

# ── Vite specific
vite.config.js.timestamp-*
*.local

# ── Cache & temp files
.cache/
.temp/
.tmp/
*.tgz

# ── MongoDB local data
data/db/
dump/

# ── Uploads / user media (if stored locally)
backend/uploads/
backend/public/uploads/

# ── Vercel
.vercel/
.vercel

# ── Misc
*.zip
*.tar.gz
.eslintcache